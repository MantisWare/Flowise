{
    "name": "flowise-runner",
    "version": "1.0.0",
    "description": "Flowise Headless API Service - Standalone API server without UI",
    "main": "dist/start.js",
    "types": "dist/start.d.ts",
    "scripts": {
        "build": "tsc",
        "start": "node dist/start.js",
        "dev": "tsc-watch --onSuccess \"node dist/start.js\"",
        "clean": "rimraf dist",
        "typeorm": "typeorm-ts-node-commonjs",
        "typeorm:migration-generate": "pnpm typeorm migration:generate -d ./src/utils/typeormDataSource.ts",
        "typeorm:migration-run": "pnpm typeorm migration:run -d ./src/utils/typeormDataSource.ts",
        "typeorm:migration-revert": "pnpm typeorm migration:revert -d ./src/utils/typeormDataSource.ts"
    },
    "keywords": ["flowise", "api", "headless"],
    "homepage": "https://flowiseai.com",
    "author": {
        "name": "FlowiseAI"
    },
    "engines": {
        "node": ">=18.15.0 <19.0.0 || ^20"
    },
    "license": "SEE LICENSE IN LICENSE.md",
